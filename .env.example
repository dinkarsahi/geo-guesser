# Where the shared leaderboard lives. Copy this file to .env and fill both in
# from your Supabase project: Settings → API.
#
# Both of these end up in the built bundle, which is fine and intended — the
# anon key is a public key. What it's allowed to do is set by the row-level
# policies in supabase/schema.sql, not by keeping it secret. Never put the
# service_role key here; that one bypasses the policies.
#
# Leave them unset and the game still runs: head-to-head falls back to
# standings kept on the device, as it worked before.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
